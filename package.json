{
  "name": "openingdrill",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client && tsc -p scripts/tsconfig.json && tsc -p tsconfig.tests.json",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "docker:up": "docker compose --profile full up --build -d",
    "docker:down": "docker compose --profile full down",
    "db:push": "npm run db:push -w server",
    "generate-course": "tsx scripts/generate-course.ts",
    "db:seed": "npm run db:seed -w server",
    "test": "jest",
    "test:e2e": "playwright test",
    "lint": "npm run lint -w client",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "chess.js": "^1.4.0",
    "concurrently": "^10.0.5",
    "jest": "^30.5.2",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  },
  "type": "module",
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
