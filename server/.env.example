# Copy to .env. The database itself arrives with Docker Compose in Step 2.
PORT=3001
DATABASE_URL="postgresql://openingdrill:openingdrill@localhost:5432/openingdrill?schema=public"

# Lichess personal token (no scopes). Needed from Step 5 for the opening explorer.
LICHESS_TOKEN=

# Signs login cookies. Use a long random string.
JWT_SECRET=change-me

# Optional: "Continue with Google". Create an OAuth client at console.cloud.google.com
# with the redirect address <PUBLIC_URL>/api/auth/google/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# The site's address as visitors see it. Defaults to http://localhost:5173.
# PUBLIC_URL=

# Production only (set on Render, see render.yaml).
# DATABASE_SSL=true
# TRUST_PROXY=3
