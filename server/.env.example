# Copy to .env. The database itself arrives with Docker Compose in Step 2.
PORT=3001
DATABASE_URL="postgresql://openingdrill:openingdrill@localhost:5432/openingdrill?schema=public"

# Lichess personal token (no scopes). Needed from Step 5 for the opening explorer.
LICHESS_TOKEN=

# Signs login cookies. Use a long random string.
JWT_SECRET=change-me

# Production only (set on Render, see render.yaml).
# DATABASE_SSL=true
# TRUST_PROXY=3
